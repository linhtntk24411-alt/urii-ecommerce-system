{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "analytics": false
  },
  "newProjectRoot": "projects",
  "projects": {
    "my-user": {
      "projectType": "application",
      "schematics": {},
      "root": "projects/my-user",
      "sourceRoot": "projects/my-user/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "projects/my-user/src/main.ts",
            "tsConfig": "projects/my-user/tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/my-user/public"
              }
            ],
            "styles": [
                        "node_modules/bootstrap/dist/css/bootstrap.min.css",
                        "node_modules/bootstrap-icons/font/bootstrap-icons.css",
                        "projects/my-user/src/styles.css"],
            "scripts": ["node_modules/bootstrap/dist/js/bootstrap.bundle.min.js"],
            "server": "projects/my-user/src/main.server.ts",
            "outputMode": "server",
            "security": {
              "allowedHosts": []
            },
            "ssr": {
              "entry": "projects/my-user/src/server.ts"
            }
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "proxyConfig": "proxy.conf.json"
          },
          "configurations": {
            "production": {
              "buildTarget": "my-user:build:production"
            },
            "development": {
              "buildTarget": "my-user:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test"
        }
      }
    },
    "my-admin": {
      "projectType": "application",
      "schematics": {},
      "root": "projects/my-admin",
      "sourceRoot": "projects/my-admin/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "projects/my-admin/src/main.ts",
            "tsConfig": "projects/my-admin/tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/my-admin/public"
              }
            ],
            "styles": [
                        "node_modules/bootstrap/dist/css/bootstrap.min.css",
                        "node_modules/bootstrap-icons/font/bootstrap-icons.css",
                        "projects/my-admin/src/styles.css"
                      ],
            "scripts": ["node_modules/bootstrap/dist/js/bootstrap.bundle.min.js"],
            "server": "projects/my-admin/src/main.server.ts",
            "outputMode": "server",
            "security": {
              "allowedHosts": []
            },
            "ssr": {
              "entry": "projects/my-admin/src/server.ts"
            }
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "proxyConfig": "proxy.conf.json"
          },
          "configurations": {
            "production": {
              "buildTarget": "my-admin:build:production"
            },
            "development": {
              "buildTarget": "my-admin:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test"
        }
      }
    }
  }
}
