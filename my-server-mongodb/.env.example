MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/UriiDB?retryWrites=true&w=majority
PORT=3002
NODE_ENV=development
ALLOW_PUBLIC_USER_READS=true
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
CORS_ORIGINS=http://localhost:4200,http://localhost:4201
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=replace-with-a-unique-password-of-at-least-12-characters
SEED_ADMIN_NAME=Urii Admin
# Register these exact callback URLs with each OAuth provider.
GOOGLE_OAUTH_CLIENT_ID=your-google-client-id
GOOGLE_OAUTH_CLIENT_SECRET=your-google-client-secret
GOOGLE_OAUTH_CALLBACK_URL=http://localhost:3002/api/auth/oauth/google/callback
FACEBOOK_OAUTH_CLIENT_ID=your-facebook-app-id
FACEBOOK_OAUTH_CLIENT_SECRET=your-facebook-app-secret
FACEBOOK_OAUTH_CALLBACK_URL=http://localhost:3002/api/auth/oauth/facebook/callback
FACEBOOK_GRAPH_VERSION=v26.0