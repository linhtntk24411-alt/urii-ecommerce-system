        {
          "name": "1.3. [POST] Đăng ký & Gửi mã OTP qua Email (200 OK - Send OTP)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('HTTP Status là 200 OK (hoặc 409 nếu email đã tồn tại)', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 409]);",
                  "});",
                  "pm.test('Response Time < 10000ms (gửi mail SMTP)', function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(10000);",
                  "});",
                  "pm.test('JSON Payload xác nhận requireOtp = true', function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('message');",
                  "    if (pm.response.code === 200) {",
                  "        pm.expect(jsonData.requireOtp).to.eql(true);",
                  "    }",
                  "});"
